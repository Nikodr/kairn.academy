# Simulateur OPCO (/simulateur-opco). Variables lues au build : elles sont publiques (visibles dans le navigateur).
# Ne jamais mettre ici de jeton Airtable : il reste dans l'intermédiaire (Worker Cloudflare ou webhook).

# URL du webhook de l'automatisation Airtable « Simulateur OPCO : nouveau lead » (POST formulaire).
# Cette URL n'est pas un secret (elle est lisible dans le navigateur), mais elle donne le droit d'écrire dans la table.
PUBLIC_OPCO_LEADS_ENDPOINT=

# Clé de site (publique) Cloudflare Turnstile. En développement, une clé de test est utilisée si elle est absente.
PUBLIC_TURNSTILE_SITE_KEY=
